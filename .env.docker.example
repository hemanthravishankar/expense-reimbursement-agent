# Development/demo-only PostgreSQL credentials.
# Change these for any shared or non-local environment.
POSTGRES_USER=expense_agent
POSTGRES_PASSWORD=expense_agent_dev_password
POSTGRES_DB=expense_agent

# The Dockerized API calls Ollama running on the host.
# macOS / Windows Docker Desktop:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Linux Compose also gets host.docker.internal through extra_hosts.
# If your host Ollama uses another address, override this value.
